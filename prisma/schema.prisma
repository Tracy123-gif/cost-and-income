// Business Production Costing & Profit Tracker
// Core data model. See spec: docs/SPEC.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BaseUnit {
  GRAM
  ML
  PIECE
}

enum PurchaseUnit {
  KG
  G
  LITRE
  ML
  PIECE
}

enum InventoryTxnType {
  PURCHASE
  PRODUCTION_CONSUMPTION
  ADJUSTMENT
  WASTAGE
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  OTHER
}

enum SaleStatus {
  COMPLETED
  REFUNDED
  VOIDED
}

model Business {
  id        String   @id @default(cuid())
  name      String
  currency  String   @default("NGN")
  timezone  String   @default("Africa/Lagos")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingredients Ingredient[]
  recipes     Recipe[]
  sales       Sale[]
  expenses    Expense[]
  suppliers   Supplier[]
  auditLogs   AuditLog[]
}

model Supplier {
  id         String  @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  contact    String?
  active     Boolean @default(true)

  purchases Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ingredient {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  category    String?
  baseUnit    BaseUnit
  // Running weighted-average stock, always in baseUnit.
  currentStock   Decimal @default(0) @db.Decimal(18, 4)
  minStockLevel  Decimal @default(0) @db.Decimal(18, 4)
  // Weighted-average cost per base unit.
  avgCostPerUnit Decimal @default(0) @db.Decimal(18, 6)
  active         Boolean @default(true)

  purchases            Purchase[]
  inventoryTransactions InventoryTransaction[]
  recipeIngredients    RecipeIngredient[]
  productionConsumptions ProductionConsumption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
}

model Purchase {
  id           String   @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  supplierId   String?
  supplier     Supplier?  @relation(fields: [supplierId], references: [id])

  purchaseDate DateTime @default(now())
  // As entered by the user, e.g. 50 KG.
  packageQuantity Decimal @db.Decimal(18, 4)
  packageUnit     PurchaseUnit
  // Normalized into the ingredient's base unit, e.g. 50000 G.
  quantityInBaseUnit Decimal @db.Decimal(18, 4)
  totalPrice         Decimal @db.Decimal(18, 2)
  // totalPrice / quantityInBaseUnit
  unitCost           Decimal @db.Decimal(18, 6)
  note               String?

  inventoryTransaction InventoryTransaction?

  createdAt DateTime @default(now())

  @@index([ingredientId])
}

model InventoryTransaction {
  id           String            @id @default(cuid())
  ingredientId String
  ingredient   Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  type         InventoryTxnType
  // Signed quantity in the ingredient's base unit. Positive = stock in, negative = stock out.
  quantity     Decimal           @db.Decimal(18, 4)
  balanceAfter Decimal           @db.Decimal(18, 4)
  unitCostAtTime Decimal         @db.Decimal(18, 6)

  purchaseId   String?  @unique
  purchase     Purchase? @relation(fields: [purchaseId], references: [id])
  productionConsumptionId String? @unique
  productionConsumption   ProductionConsumption? @relation(fields: [productionConsumptionId], references: [id])

  note      String?
  createdAt DateTime @default(now())

  @@index([ingredientId])
}

model Recipe {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productName    String
  sku            String?
  // Quantity of finished units this recipe produces in one batch (e.g. 10 cups).
  outputQuantity Decimal  @db.Decimal(18, 4)
  outputUnit     String   @default("unit")
  packagingCost  Decimal  @default(0) @db.Decimal(18, 2)
  directLaborCost Decimal @default(0) @db.Decimal(18, 2)
  otherDirectCost Decimal @default(0) @db.Decimal(18, 2)
  sellingPrice    Decimal @default(0) @db.Decimal(18, 2)
  active          Boolean @default(true)

  ingredients     RecipeIngredient[]
  productionBatches ProductionBatch[]
  saleItems       SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
}

model RecipeIngredient {
  id           String   @id @default(cuid())
  recipeId     String
  recipe       Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  // Quantity required, in the ingredient's base unit, per one batch.
  quantity     Decimal  @db.Decimal(18, 4)

  @@index([recipeId])
}

model ProductionBatch {
  id             String   @id @default(cuid())
  recipeId       String
  recipe         Recipe   @relation(fields: [recipeId], references: [id])
  producedAt     DateTime @default(now())
  plannedOutput  Decimal  @db.Decimal(18, 4)
  actualOutput   Decimal  @db.Decimal(18, 4)
  // Sum of ingredient costs, snapshotted at production time.
  ingredientCost Decimal  @db.Decimal(18, 2)
  packagingCost  Decimal  @db.Decimal(18, 2)
  laborCost      Decimal  @db.Decimal(18, 2)
  otherCost      Decimal  @db.Decimal(18, 2)
  totalBatchCost Decimal  @db.Decimal(18, 2)
  costPerUnit    Decimal  @db.Decimal(18, 4)
  // Finished units from this batch not yet sold/voided. Lets the app answer "how much stock do I have?"
  // for finished goods, not just raw ingredients.
  unitsRemaining Decimal  @db.Decimal(18, 4)
  wastageNote    String?
  notes          String?

  consumptions   ProductionConsumption[]
  saleItems      SaleItem[]

  createdAt DateTime @default(now())

  @@index([recipeId])
}

model ProductionConsumption {
  id                 String   @id @default(cuid())
  productionBatchId  String
  productionBatch    ProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)
  ingredientId       String
  ingredient         Ingredient @relation(fields: [ingredientId], references: [id])
  // Quantity consumed, in the ingredient's base unit.
  quantityConsumed   Decimal  @db.Decimal(18, 4)
  // Ingredient's weighted-average cost per base unit at the moment of consumption.
  unitCostAtTime     Decimal  @db.Decimal(18, 6)
  costAtTime         Decimal  @db.Decimal(18, 2)

  inventoryTransaction InventoryTransaction?

  @@index([productionBatchId])
}

model Sale {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  saleDate        DateTime @default(now())
  paymentMethod   PaymentMethod @default(CASH)
  customerRef     String?
  discountAmount  Decimal  @default(0) @db.Decimal(18, 2)
  status          SaleStatus @default(COMPLETED)
  note            String?

  items SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
}

model SaleItem {
  id                String   @id @default(cuid())
  saleId            String
  sale              Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  recipeId          String
  recipe            Recipe   @relation(fields: [recipeId], references: [id])
  productionBatchId String?
  productionBatch   ProductionBatch? @relation(fields: [productionBatchId], references: [id])

  quantity      Decimal @db.Decimal(18, 4)
  unitPrice     Decimal @db.Decimal(18, 2)
  // Cost of goods sold per unit, snapshotted from the production batch cost per unit.
  unitCost      Decimal @db.Decimal(18, 4)
  lineRevenue   Decimal @db.Decimal(18, 2)
  lineCogs      Decimal @db.Decimal(18, 2)

  @@index([saleId])
}

model Expense {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   String
  amount     Decimal  @db.Decimal(18, 2)
  expenseDate DateTime @default(now())
  note       String?

  createdAt DateTime @default(now())

  @@index([businessId])
}

model AuditLog {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  action     String
  beforeJson String?
  afterJson  String?
  createdAt  DateTime @default(now())

  @@index([businessId])
  @@index([entityType, entityId])
}
